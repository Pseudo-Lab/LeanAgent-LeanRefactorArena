{
  "schema_version": 1,
  "problem": "../../examples/first-harness/problem.json",
  "template": "../../examples/first-harness/context.lean.in",
  "project": "../../examples/first-harness/project",
  "prompt": "prompt.txt",
  "lean": {
    "toolchain": "leanprover/lean4:v4.26.0",
    "command": [
      "lean",
      "-j1",
      "-M1024",
      "-T20000"
    ],
    "timeout_seconds": 30,
    "repetitions": 3
  },
  "limits": {
    "max_calls": 10,
    "max_proof_characters": 4000,
    "max_feedback_characters": 1200,
    "max_request_characters": 48000
  },
  "model": {
    "backend": "fixture",
    "responses": "responses.json"
  },
  "agent": {
    "mode": "actions-v1",
    "corpus": "corpus.json",
    "history_limit": 4,
    "candidate_limit": 4
  }
}
